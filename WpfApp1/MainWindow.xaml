<pu:WindowX
    x:Class="WpfApp1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pu="https://opensource.panuon.com/wpf-ui"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title=""
    Width="300"
    Height="400"
    Topmost="True"
    pu:WindowXCaption.Height="30"
    pu:WindowXCaption.Background="LightPink"
    IsEscEnabled="True"
    IsF11Enabled="True"
    IsMaskVisible="False"
    IsOverlayerVisible="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--  添加圆角窗体效果👇👇👇  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CornerRadius="25"
            GlassFrameThickness="0"
            ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <!--  添加圆角窗体效果👆👆👆  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!--  顶部闪烁广告  -->
        <Border
            Margin="0"
            Padding="20"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="LightPink">
            <TextBlock
                x:Name="TopAdText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Cursor="Hand"
                FontSize="18"
                 Padding="10"
                FontWeight="Bold"
                Foreground="DarkRed"
                MouseLeftButtonDown="TopAdText_MouseLeftButtonDown"
                Text="【广告】点击领取优惠券！">

                <!--  原有的闪烁动画保留  -->
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    AutoReverse="True"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1.0"
                                    To="0.2"
                                    Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </Border>

        <!--  WebView  -->
        <wv2:WebView2
    x:Name="webView"
    Grid.Row="1"
    Margin="0"
    VerticalAlignment="Stretch"
    HorizontalAlignment="Stretch"
    Source="https://www.cnxgct.com/video/wanmeishijieguoyu-chendong/HeoYwS5JsH.html" />

        <!--  底部闪烁广告  -->
        <!--  底部循环滚动广告  -->
        <Border
            Grid.Row="2"
            Padding="10"
            Background="#E6F9E6">
            <Canvas
                x:Name="AdCanvas"
                Width="300"
                Height="30"
                ClipToBounds="True">
                <TextBlock
                    x:Name="ScrollingAdText"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="DarkGreen"
                    Text="【赞助广告】下载我们的APP，享受更多福利！">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="AdTextTransform" X="300" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Border>
    </Grid>
</pu:WindowX>
