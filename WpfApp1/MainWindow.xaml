<pu:WindowX
    x:Class="WpfApp1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pu="https://opensource.panuon.com/wpf-ui"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title=""
    Width="1100"
    Height="800"  Icon="{x:Null}"
    pu:WindowXCaption.Background="White"
    pu:WindowXCaption.Buttons="MinimizeClose"
    pu:WindowXCaption.HeaderAlignment="Stretch"
    pu:WindowXCaption.Height="30"
    IsEscEnabled="True"
    IsF11Enabled="True"
    IsMaskVisible="False"
    IsOverlayerVisible="False"
    Topmost="True"  
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <pu:WindowXCaption.ExtendControl>
        <StackPanel Orientation="Horizontal">
            <!-- 设置按钮 -->
            <Button
                Width="30"
                Height="30"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="SettingsButton_Click"
                Content="⚙"
                Cursor="Hand"
                FontSize="14"
                Foreground="Black"
                ToolTip="设置" />

            <!-- 隐藏到托盘 -->
            <Button
                Width="30"
                Height="30"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="HideButton_Click"
                Content="📌"
                Cursor="Hand"
                FontSize="14"
                Foreground="Black"
                ToolTip="隐藏到托盘" />
        </StackPanel>
    </pu:WindowXCaption.ExtendControl>

    <pu:WindowXCaption.MinimizeButtonStyle>
        <Style BasedOn="{StaticResource {x:Static pu:WindowXCaption.MinimizeButtonStyleKey}}" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="pu:ButtonHelper.HoverBackground" Value="{x:Null}" />
            <Setter Property="pu:ButtonHelper.HoverForeground" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Content" Value="&#xe903;" />
        </Style>
    </pu:WindowXCaption.MinimizeButtonStyle>

    <pu:WindowXCaption.CloseButtonStyle>
        <Style BasedOn="{StaticResource {x:Static pu:WindowXCaption.CloseButtonStyleKey}}" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="pu:ButtonHelper.HoverBackground" Value="{x:Null}" />
            <Setter Property="pu:ButtonHelper.HoverForeground" Value="White" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
    </pu:WindowXCaption.CloseButtonStyle>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CornerRadius="25"
            GlassFrameThickness="0"
            ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <wv2:WebView2
            x:Name="webView"
            Grid.Row="0"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Source="https://www.cqzypg.online/" />

        <tb:TaskbarIcon
            x:Name="MyTrayIcon"
            IconSource="/WpfApp1;component/Resources/Images/head.ico"
            ToolTipText="我的应用名称"
            TrayLeftMouseDown="TrayIcon_OnLeftMouseDown"
            Visibility="Collapsed">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="ShowWindow_Click" Header="打开主窗口" />
                    <MenuItem Click="SettingsButton_Click" Header="设置" />
                    <Separator />
                    <MenuItem Click="ExitApp_Click" Header="退出" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</pu:WindowX>