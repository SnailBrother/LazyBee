<pu:WindowX
    x:Class="WpfApp1.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pu="https://opensource.panuon.com/wpf-ui"
    Title="请输入网址"
    Width="400"
    Height="220"
  
     WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 提示文字 -->
        <TextBlock Text="请输入要加载的网址：" Margin="0,0,0,5" />

        <!-- 输入框 -->
        <TextBox x:Name="UrlInput" Grid.Row="1" Height="26" />

       
        <!-- 快捷选项 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="🎵 听歌" Width="100" Margin="0,0,10,0" Click="QuickSelect_Click" Tag="http://121.4.22.55/app/music/home" />
            <Button Content="📺 看电视" Width="100" Click="QuickSelect_Click" Tag="https://www.cnxgct.com/video/wanmeishijieguoyu-chendong/HeoYwS5JsH.html" />
        </StackPanel>
        <!-- 确认/取消按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="70" Margin="0,0,10,0" Click="OkButton_Click" />
            <Button Content="取消" Width="70" Click="CancelButton_Click" />
        </StackPanel>

    </Grid>
</pu:WindowX>